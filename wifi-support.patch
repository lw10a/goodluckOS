diff -ruN orig/rootfs/board/my-device/rootfs-overlay/usr/local/bin/wifi.sh goodluckOS-main/rootfs/board/my-device/rootfs-overlay/usr/local/bin/wifi.sh
--- orig/rootfs/board/my-device/rootfs-overlay/usr/local/bin/wifi.sh	1970-01-01 00:00:00.000000000 +0000
+++ goodluckOS-main/rootfs/board/my-device/rootfs-overlay/usr/local/bin/wifi.sh	2026-11-05 20:28:07.062904861 +0000
@@ -0,0 +1,74 @@
+#!/bin/sh
+# goodluckOS Wi-Fi helper (RTL8188FTV / rtl8xxxu, wlan0)
+#   wifi.sh scan                    list nearby networks
+#   wifi.sh connect SSID [PASS]     connect (PASS omitted = open network); saved for next time
+#   wifi.sh auto                    reconnect to the saved network
+#   wifi.sh status                  show link / IP
+#   wifi.sh off                     disconnect and stop
+IF=wlan0
+CONF=/home/player/.config/wifi/wpa_supplicant.conf
+LOG=/tmp/wifi.log
+
+need_if() {
+    [ -d /sys/class/net/$IF ] || { echo "$IF not found. Dongle plugged in (OTG cable)? dmesg | tail"; exit 1; }
+}
+
+stop_all() {
+    killall wpa_supplicant 2>/dev/null
+    killall udhcpc 2>/dev/null
+}
+
+start_conn() {
+    stop_all
+    ip link set $IF up
+    wpa_supplicant -B -i $IF -D nl80211 -c "$CONF" -f $LOG || { echo "wpa_supplicant failed, see $LOG"; exit 1; }
+    echo "Waiting for association..."
+    i=0
+    while [ $i -lt 20 ]; do
+        iw dev $IF link 2>/dev/null | grep -q "^Connected" && break
+        sleep 1; i=$((i + 1))
+    done
+    udhcpc -i $IF -q -n -t 5 2>&1 | tail -n 3
+    status
+}
+
+status() {
+    iw dev $IF link 2>&1
+    ip -4 addr show $IF 2>&1 | grep inet
+}
+
+case "$1" in
+  scan)
+    need_if
+    ip link set $IF up
+    iw dev $IF scan 2>&1 | awk '
+      /^BSS /      { if (ssid != "") print sig "  " ssid; ssid=""; sig="" }
+      /signal:/    { sig=$2 }
+      /SSID:/      { sub(/^[ \t]*SSID: /, ""); ssid=$0 }
+      END          { if (ssid != "") print sig "  " ssid }' | sort -rn | uniq
+    ;;
+  connect)
+    need_if
+    [ -n "$2" ] || { echo "Usage: wifi.sh connect SSID [PASS]"; exit 1; }
+    mkdir -p "$(dirname "$CONF")"
+    {
+      echo "ctrl_interface=/var/run/wpa_supplicant"
+      echo "update_config=1"
+      if [ -n "$3" ]; then
+          wpa_passphrase "$2" "$3" | grep -v '^\s*#psk'
+      else
+          printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$2"
+      fi
+    } > "$CONF"
+    chmod 600 "$CONF"
+    start_conn
+    ;;
+  auto)
+    need_if
+    [ -f "$CONF" ] || { echo "No saved network. Use: wifi.sh connect SSID PASS"; exit 1; }
+    start_conn
+    ;;
+  status) need_if; status ;;
+  off)    stop_all; ip link set $IF down 2>/dev/null; echo "Wi-Fi off" ;;
+  *)      echo "Usage: wifi.sh {scan|connect SSID [PASS]|auto|status|off}"; exit 1 ;;
+esac
